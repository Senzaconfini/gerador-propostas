# ─────────────────────────────────────────────
# GERADOR DE PROPOSTAS — Configuração
# Copie este arquivo para .env.local e preencha
# ─────────────────────────────────────────────

# Senha de acesso ao app — obrigatório
# Escolha qualquer senha forte. Compartilhe com quem precisar acessar.
APP_PASSWORD=sua-senha-aqui

# Anthropic (Claude) — obrigatório | Cria conta em: console.anthropic.com
# ATENÇÃO: Adicione um cartão de crédito antes de começar (não funciona só com conta gratuita)
# Custo médio: ~R$ 0,10 por proposta gerada
ANTHROPIC_API_KEY=sk-ant-...

# Supabase — obrigatório | Cria projeto em: supabase.com
# Pegue em: Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Groq (transcrição de áudio) — opcional | Cria conta em: console.groq.com
# Gratuito. Permite transcrever áudios do WhatsApp automaticamente.
GROQ_API_KEY=gsk_...

# UAZAPI (histórico WhatsApp) — opcional | Cria em: uazapiGO.com
# Permite puxar o histórico de conversa do WhatsApp automaticamente.
UAZAPI_BASE_URL=https://free.uazapi.com
UAZAPI_INSTANCE_TOKEN=
