# ══════════════════════════════════════════════════════════
#  GERADOR DE PROPOSTAS — Preencha cada campo abaixo
#  Após preencher, salve o arquivo e siga para o Passo 6
# ══════════════════════════════════════════════════════════


# ── PASSO 5A · Senha de acesso ao app ─────────────────────
# Escolha qualquer senha. Você vai usar essa senha para entrar no app.
APP_PASSWORD=


# ── PASSO 5B · Claude API (obrigatório) ───────────────────
# Onde pegar: console.anthropic.com → API Keys → Create Key
# ATENÇÃO: cadastre um cartão de crédito antes de começar
# Custo: ~R$ 0,10 por proposta (você ganha US$5 de crédito grátis ao criar a conta)
ANTHROPIC_API_KEY=


# ── PASSO 5C · Groq — transcrição de áudio (gratuito) ────
# Onde pegar: console.groq.com → API Keys → Create API Key
GROQ_API_KEY=


# ── PASSO 5D · Supabase (obrigatório) ────────────────────
# Onde pegar: supabase.com → seu projeto → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ── PASSO 5E · UAZAPI — histórico do WhatsApp (opcional) ─
# Onde pegar: uazapi.com → crie uma instância → copie o token
# Deixe em branco se não for usar
UAZAPI_BASE_URL=https://free.uazapi.com
UAZAPI_INSTANCE_TOKEN=
